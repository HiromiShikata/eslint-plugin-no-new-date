{
  "name": "eslint-plugin-no-new-date",
  "version": "1.0.0",
  "description": "ESLint plugin that disallows the use of new Date() to enforce timezone-aware date handling",
  "main": "dist/index.js",
  "scripts": {
    "prettier": "prettier --ignore-unknown --write '**/*'",
    "lint": "eslint src",
    "lint-fix": "eslint src --fix",
    "fmt": "npm run prettier && npm run lint-fix",
    "build": "tsc -p ./tsconfig.build.json",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HiromiShikata/eslint-plugin-no-new-date.git"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "no-new-date",
    "date",
    "timezone"
  ],
  "author": "HiromiShikata",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/HiromiShikata/eslint-plugin-no-new-date/issues"
  },
  "release": {
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/git"
    ],
    "branches": [
      "main"
    ]
  },
  "homepage": "https://github.com/HiromiShikata/eslint-plugin-no-new-date#readme",
  "peerDependencies": {
    "eslint": ">=8.0.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.6",
    "@babel/eslint-parser": "8.0.6",
    "@babel/preset-typescript": "8.0.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@swc/core": "1.16.13",
    "@swc/jest": "^0.2.39",
    "@types/eslint": "9.6.1",
    "@types/jest": "^30.0.0",
    "check-node-version": "^4.2.1",
    "commitlint": "21.2.3",
    "conventional-changelog-conventionalcommits": "10.4.0",
    "eslint": "10.12.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "jest": "30.5.2",
    "jest-html-reporter": "4.4.2",
    "jest-junit": "^17.0.0",
    "prettier": "3.9.9",
    "semantic-release": "25.0.9",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "handlebars": "^4.7.10",
    "npm": "^11.21.0"
  }
}
